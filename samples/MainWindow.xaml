<Window x:Class="Inventory.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Inventory" Height="450" Width="800">
<Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<StackPanel Orientation="Horizontal" Grid.Row="0"><TextBox x:Name="SearchBox" Width="240"/><Button x:Name="SearchButton" Content="Search" Margin="8,0,0,0"/></StackPanel>
<DataGrid x:Name="Items" Grid.Row="1" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="SKU" Binding="{Binding Sku}"/><DataGridTextColumn Header="Name" Binding="{Binding Name}"/><DataGridTextColumn Header="Stock" Binding="{Binding Stock}"/></DataGrid.Columns></DataGrid>
</Grid>
</Window>
